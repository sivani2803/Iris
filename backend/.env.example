# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Connection
# If local MongoDB is unavailable, backend will automatically fallback to in-memory MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/iris

# Security & Cryptographic Tokens
JWT_SECRET=iris-prod-access-token-secret-e2e-2026
DISABLE_RATE_LIMITING=false

# Firebase Authentication Integration (Optional: Decoupled offline verification fallback active when empty)
FIREBASE_PROJECT_ID=iris-senior-care
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Gemini AI Integration (Leave blank to use clinical safety fallback mode)
GEMINI_API_KEY=

# ML Risk Microservice Endpoint (Falls back to deterministic clinical heuristic when circuit open)
ML_SERVICE_URL=http://localhost:8000/v1/anomaly/predict

# Emergency Services Gateway Webhook (Optional Level 3 108 Dispatch integration)
EMS_DISPATCH_WEBHOOK=
